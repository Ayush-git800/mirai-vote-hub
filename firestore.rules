rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Registered user profiles and credentials
    match /users/{studentId} {
      // First-time PIN claiming and verification
      allow read, create: if true;
      // Allow update only for student's own credentials
      allow update: if request.resource.data.rollNo == studentId;
      allow delete: if false;
    }

    // 2. Multi-tenant elections and nested subcollections
    match /elections/{electionId} {
      // Public read for election listings and ballot configurations
      allow read: if true;
      // Election lifecycle management (draft, active, sealed, certified)
      allow create, update, delete: if true;

      // Election-specific whitelist subcollection
      match /whitelist/{studentId} {
        allow read: if true;
        allow create, delete: if true;
        // Allow updating hasVoted only from false to true (or admin reset)
        allow update: if (resource.data.hasVoted == false && request.resource.data.hasVoted == true) 
                      || request.resource.data.hasVoted == false;
      }

      // Election-specific candidates subcollection
      match /candidates/{candidateId} {
        allow read: if true;
        allow create, delete: if true;
        // Voters can atomically increment voteCount by exactly +1 while election is active,
        // or admin can update candidate details / reset
        allow update: if (request.resource.data.voteCount == resource.data.voteCount + 1 
                          && get(/databases/$(database)/documents/elections/$(electionId)).data.status == "active")
                      || request.resource.data.voteCount == resource.data.voteCount
                      || request.resource.data.voteCount == 0;
      }

      // Decoupled anonymous votes inside election
      match /votes/{voteId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false; // Immutable sealed audit trail
      }
    }

    // 3. Root Whitelist collection (fallback and global voter registry)
    match /whitelist/{studentId} {
      allow read: if true;
      allow create, delete: if true;
      allow update: if (resource.data.hasVoted == false && request.resource.data.hasVoted == true)
                    || request.resource.data.hasVoted == false;
    }

    // 4. Root Candidates collection
    match /candidates/{candidateId} {
      allow read: if true;
      allow create, delete: if true;
      allow update: if request.resource.data.voteCount == resource.data.voteCount + 1
                    || request.resource.data.voteCount == resource.data.voteCount
                    || request.resource.data.voteCount == 0;
    }

    // 5. Root Anonymous Decoupled Ballots (Sealed Audit Trail)
    match /votes/{voteId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Immutable sealed audit trail
    }

    // 6. Global Election Metadata & Configuration
    match /election_meta/{metaId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. System activity and audit logs
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
